<% content_for :title, "Change password · Budget App" %>

<section class="auth">
  <div class="auth__card card card--padded">
    <h1 class="auth__title">Change your password</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                 html: { method: :put, class: "form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="form__field">
        <%= f.label :password, "New password", class: "form__label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form__input" %>
        <% if @minimum_password_length %>
          <p class="form__hint"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div class="form__field">
        <%= f.label :password_confirmation, "Confirm new password", class: "form__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form__input" %>
      </div>

      <div class="form__actions">
        <%= f.submit "Change my password", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
