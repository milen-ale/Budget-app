<% content_for :title, "Reset password · Budget App" %>

<section class="auth">
  <div class="auth__card card card--padded">
    <%= link_to "← Back", root_path, class: "auth__back" %>
    <h1 class="auth__title">Forgot your password?</h1>
    <p class="auth__subtitle">Enter your email and we'll send you reset instructions.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                 html: { method: :post, class: "form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form__field">
        <%= f.label :email, class: "form__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form__input" %>
      </div>

      <div class="form__actions">
        <%= f.submit "Send reset instructions", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
