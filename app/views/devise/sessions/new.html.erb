<% content_for :title, "Log in · Budget App" %>

<section class="auth">
  <div class="auth__card card card--padded">
    <%= link_to "← Back", root_path, class: "auth__back" %>
    <span class="auth__mark" aria-hidden="true">💸</span>
    <h1 class="auth__title">Welcome back</h1>
    <p class="auth__subtitle">Log in to keep tracking your spending.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }) do |f| %>
      <div class="form__field">
        <%= f.label :email, class: "form__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form__input" %>
      </div>

      <div class="form__field">
        <%= f.label :password, class: "form__label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form__input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form__field form__field--inline">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, class: "form__label form__label--inline" %>
        </div>
      <% end %>

      <div class="form__actions">
        <%= f.submit "Log in", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
