<% content_for :title, "Edit expense · Budget App" %>

<section class="narrow">
  <div class="page-head">
    <div class="page-head__title-group">
      <%= category_icon(@budget_category.icon) %>
      <div>
        <h1 class="page-head__title">Edit expense</h1>
        <p class="page-head__subtitle">in <%= @budget_category.name %></p>
      </div>
    </div>
  </div>
  <div class="card card--padded">
    <%= render "form", expense: @expense %>
  </div>

  <div class="danger-zone">
    <%= button_to "Delete expense", budget_category_expense_path(@budget_category, @expense), method: :delete,
                  class: "btn btn--danger",
                  form: { data: { turbo_confirm: "Delete #{@expense.name}?" } } %>
  </div>
</section>
