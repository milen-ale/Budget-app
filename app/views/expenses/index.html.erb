<% content_for :title, "#{@budget_category.name} · Budget App" %>

<section class="detail">
  <div class="page-head">
    <div class="page-head__title-group">
      <%= link_to budget_categories_path, class: "btn btn--ghost btn--icon", aria: { label: "Back to categories" } do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
      <% end %>
      <%= category_icon(@budget_category.icon) %>
      <div>
        <h1 class="page-head__title"><%= @budget_category.name %></h1>
        <p class="page-head__subtitle"><%= pluralize(@expenses.size, 'expense') %></p>
      </div>
    </div>
    <%= link_to "Edit", edit_budget_category_path(@budget_category), class: "btn btn--ghost" %>
  </div>

  <div class="stat-tile">
    <p class="stat-tile__label">Total in <%= @budget_category.name %></p>
    <p class="stat-tile__value"><%= number_to_currency(@total) %></p>
  </div>

  <div class="detail__actions">
    <%= link_to "＋ Add expense", new_budget_category_expense_path(@budget_category), class: "btn btn--primary" %>
  </div>

  <% if @expenses.any? %>
    <ul class="expense-list card">
      <%= render @expenses %>
    </ul>
  <% else %>
    <%= render "shared/empty_state",
               emoji: "🧾",
               title: "Nothing logged yet",
               body: "Add your first expense to #{@budget_category.name} and it will show up here.",
               cta_text: "Add an expense",
               cta_path: new_budget_category_expense_path(@budget_category) %>
  <% end %>
</section>
