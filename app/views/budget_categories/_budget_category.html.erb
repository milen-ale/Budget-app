<article id="<%= dom_id(budget_category) %>" class="card category-card">
  <%= link_to budget_category_expenses_path(budget_category), class: "category-card__link" do %>
    <%= category_icon(budget_category.icon) %>
    <span class="category-card__info">
      <span class="category-card__name"><%= budget_category.name %></span>
      <span class="category-card__meta"><%= pluralize(budget_category.expense_count, 'expense') %></span>
    </span>
    <span class="category-card__total"><%= number_to_currency(budget_category.total) %></span>
  <% end %>
</article>
